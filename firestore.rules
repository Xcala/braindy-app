rules_version = '2';

// Braindy platform · Firestore database `braindy-app` only.
// The backend (Cloud Run, Admin SDK) bypasses these rules; Brain agents act through it
// and their limits (never approve, never publish, never read credentials) live in server code.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(uid()));
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(uid()))
        && userDoc().data.role == 'admin';
    }

    function memberPath(brandId) {
      return /databases/$(database)/documents/brands/$(brandId)/members/$(uid());
    }

    // Group chain of a brand, nearest first (e.g. iPark → [grupo-ibmt, grupo-berrio]).
    // Membership in any ancestor group grants the same access to the brand (multi-brand clients).
    function ancestors(brandId) {
      return get(/databases/$(database)/documents/brands/$(brandId)).data.get('ancestors', []);
    }

    function memberAt(id) {
      return exists(memberPath(id));
    }

    function ownerAt(id) {
      return memberAt(id) && get(memberPath(id)).data.role == 'client_owner';
    }

    function approverAt(id) {
      return memberAt(id)
        && (get(memberPath(id)).data.role == 'client_owner'
            || get(memberPath(id)).data.get('canApprove', false) == true);
    }

    function isMember(brandId) {
      let a = ancestors(brandId);
      return signedIn() && (memberAt(brandId)
        || (a.size() > 0 && memberAt(a[0]))
        || (a.size() > 1 && memberAt(a[1]))
        || (a.size() > 2 && memberAt(a[2])));
    }

    function isOwner(brandId) {
      let a = ancestors(brandId);
      return signedIn() && (ownerAt(brandId)
        || (a.size() > 0 && ownerAt(a[0]))
        || (a.size() > 1 && ownerAt(a[1]))
        || (a.size() > 2 && ownerAt(a[2])));
    }

    function canApprove(brandId) {
      let a = ancestors(brandId);
      return signedIn() && (approverAt(brandId)
        || (a.size() > 0 && approverAt(a[0]))
        || (a.size() > 1 && approverAt(a[1]))
        || (a.size() > 2 && approverAt(a[2])));
    }

    function canReadBrand(brandId) {
      return isAdmin() || isMember(brandId);
    }

    function onlyChanges(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // ---------- users ----------
    match /users/{userId} {
      allow read: if isAdmin() || (signedIn() && uid() == userId);
      allow create, delete: if isAdmin();
      // A user may edit their own display name; role and brandIds are admin-only.
      allow update: if isAdmin()
        || (signedIn() && uid() == userId
            && onlyChanges(['name'])
            && request.resource.data.name is string
            && request.resource.data.name.size() <= 120);
    }

    // ---------- brands ----------
    match /brands/{brandId} {
      allow read: if canReadBrand(brandId);
      allow write: if isAdmin();

      match /context/{docId} {
        allow read: if canReadBrand(brandId);
        allow write: if isAdmin();
      }

      match /assets/{assetId} {
        allow read: if canReadBrand(brandId);
        allow write: if isAdmin();
      }

      match /members/{memberId} {
        allow read: if canReadBrand(brandId);
        // Owners invite and manage members of their brand, but never edit their own entry.
        allow create, update: if isAdmin()
          || (isOwner(brandId)
              && memberId != uid()
              && request.resource.data.keys().hasOnly(['role', 'canApprove'])
              && request.resource.data.role in ['client_owner', 'client_member']
              && request.resource.data.get('canApprove', false) is bool);
        allow delete: if isAdmin() || (isOwner(brandId) && memberId != uid());
      }

      match /requests/{requestId} {
        allow read: if canReadBrand(brandId);
        // Clients open requests; routing, plan, status and approval level are set server-side.
        allow create: if isAdmin()
          || (isMember(brandId)
              && request.resource.data.createdBy == uid()
              && request.resource.data.status == 'in_production'
              && request.resource.data.keys().hasOnly([
                   'category', 'subcategory', 'formatType', 'cards', 'moodboard',
                   'dueDate', 'status', 'createdBy', 'createdAt'])
              && request.resource.data.createdAt == request.time);
        allow update, delete: if isAdmin();

        match /versions/{versionId} {
          allow read: if canReadBrand(brandId);
          allow create, delete: if isAdmin();
          // Approvers record their decision; nothing else on a version is client-editable.
          allow update: if isAdmin()
            || (canApprove(brandId)
                && onlyChanges(['approval'])
                && request.resource.data.approval.keys().hasOnly(['state', 'by', 'at', 'note'])
                && request.resource.data.approval.state in ['approved', 'changes_requested']
                && request.resource.data.approval.by == uid()
                && request.resource.data.approval.at == request.time);
        }

        match /comments/{commentId} {
          allow read: if canReadBrand(brandId);
          allow create: if (isAdmin() || isMember(brandId))
            && request.resource.data.author == uid()
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= 5000
            && request.resource.data.createdAt == request.time;
          // Resolving a comment: its author, anyone who can approve, or the admin. Text never changes.
          allow update: if isAdmin()
            || ((resource.data.author == uid() || canApprove(brandId))
                && onlyChanges(['resolved', 'resolvedBy', 'resolvedAt'])
                && request.resource.data.resolved is bool
                && request.resource.data.resolvedBy == uid());
          allow delete: if isAdmin()
            || (isMember(brandId) && resource.data.author == uid());
        }
      }

      // Credential metadata only; secrets are encrypted server-side (KMS) and revealed
      // through the backend, which writes the audit log. No client writes, ever.
      match /accesses/{accessId} {
        allow read: if isAdmin() || isOwner(brandId);
        allow write: if false;
      }

      // Billing (plan, invoices, transfer receipts): owners and admin read. Backend writes (Stripe webhook).
      match /billing/{docId} {
        allow read: if isAdmin() || isOwner(brandId);
        allow write: if false;
      }
      match /invoices/{invoiceId} {
        allow read: if isAdmin() || isOwner(brandId);
        allow write: if false;
      }
      match /transfers/{transferId} {
        allow read: if isAdmin() || isOwner(brandId);
        allow write: if false;
      }

      // Monthly reports: members see published ones; admin sees drafts. Backend writes.
      match /reports/{month} {
        allow read: if isAdmin() || (canReadBrand(brandId) && resource.data.published == true);
        allow write: if false;
      }

      // Brain insights (competitor changes, group analysis): members read. Watch snapshots: backend only.
      match /insights/{insightId} {
        allow read: if canReadBrand(brandId);
        allow write: if false;
      }
      // Meetings with the client (notes = team memory): admin only. Backend writes.
      match /meetings/{meetingId} {
        allow read: if isAdmin();
        allow write: if false;
      }
      match /watch/{pageId} {
        allow read, write: if false;
      }

      // WhatsApp notices sent (or ready to send by hand) during onboarding: admin only. Backend writes.
      match /notices/{noticeId} {
        allow read: if isAdmin();
        allow write: if false;
      }

      // Brand settings (WhatsApp number, notices). Members read; changes go through the backend.
      match /settings/{docId} {
        allow read: if canReadBrand(brandId);
        allow write: if false;
      }

      // Append-only log of every add/change/reveal/copy (never holds values). Backend writes.
      match /accessLog/{eventId} {
        allow read: if isAdmin() || isOwner(brandId);
        allow write: if false;
      }
    }

    // ---------- encrypted credential values (backend only, never readable by clients) ----------
    match /accessSecrets/{secretId} {
      allow read, write: if false;
    }

    // ---------- review links (approve from WhatsApp without login): backend only ----------
    match /reviewLinks/{token} {
      allow read, write: if false;
    }

    // ---------- onboarding sessions with Nicolas (slot bookings): admin reads, backend writes ----------
    match /sessions/{slotId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ---------- Stripe bookkeeping (customer → brand map, processed webhook events): backend only ----------
    match /stripeCustomers/{customerId} {
      allow read, write: if false;
    }
    match /stripeEvents/{eventId} {
      allow read, write: if false;
    }

    // ---------- cross-brand queries (admin only: Team queue, Brain load, search) ----------
    match /{path=**}/requests/{requestId} {
      allow read: if isAdmin();
    }
    match /{path=**}/billing/{docId} {
      allow read: if isAdmin();
    }
    match /{path=**}/transfers/{transferId} {
      allow read: if isAdmin();
    }

    // ---------- pending invitations (backend only; claimed on first sign-in) ----------
    match /invites/{inviteId} {
      allow read, write: if false;
    }

    // ---------- audit (backend writes only) ----------
    match /audit/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ---------- proposals (admin only, separate from clients) ----------
    // Prospects never sign in: the public page and its tracking go through the backend.
    match /proposals/{proposalId} {
      allow read, write: if isAdmin();

      match /files/{fileId} {
        allow read, write: if isAdmin();
      }

      // One doc per send (channel, recipient, tracked token); events are written by the backend only.
      match /sends/{sendId} {
        allow read: if isAdmin();
        allow create: if isAdmin();
        allow update, delete: if false;

        match /events/{eventId} {
          allow read: if isAdmin();
          allow write: if false;
        }
      }
    }

    // Token → proposal index for public links. Backend only.
    match /proposalLinks/{token} {
      allow read, write: if false;
    }

    // ---------- Brain task log (what each Brain did, for which brand): admin only ----------
    match /brainTasks/{taskId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ---------- brains (status board: working or ready, never what or for whom) ----------
    match /brains/{brainId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
  }
}
