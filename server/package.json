{
  "name": "@braindy/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "e2e:contracts": "tsx scripts/e2e-contracts.ts",
    "set-admin": "tsx scripts/set-admin.ts",
    "migrate:phase1": "tsx scripts/migrate/phase1.ts",
    "drive:map": "tsx scripts/drive/map-local.ts",
    "drive:map-api": "tsx scripts/drive/map.ts",
    "drive:import": "tsx scripts/drive/import.ts",
    "migrate:requests": "tsx scripts/migrate/requests.ts",
    "migrate:accesses": "tsx scripts/migrate/accesses.ts",
    "test": "tsx --test src/**/*.test.ts",
    "e2e:billing": "tsx scripts/e2e-billing.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "firebase-admin": "^14.5.0",
    "google-auth-library": "^9.15.1",
    "hono": "^4.13.13",
    "pdf-lib": "^1.17.1",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  }
}
