# Firebase web config for project braindy-brand-guideline (public identifiers, not secrets).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=braindy-brand-guideline.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=braindy-brand-guideline
VITE_FIREBASE_STORAGE_BUCKET=braindy-brand-guideline.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIRESTORE_DATABASE_ID=braindy-app
VITE_API_URL=http://localhost:8787
# Set to "true" to use the local Auth + Firestore emulators (npm run emulators).
VITE_USE_EMULATORS=false
